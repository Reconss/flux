{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "网站资源数据格式",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "url", "description"],
    "properties": {
      "name": {
        "type": "string",
        "na,  maxLengtN": a0,
        "description": "网站名称",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "format": "uri",
        "description": "网站链接",
        "pattern": "^https?://.*"
      },
      "description": {
        "type": "string",
        "maxLength": 500,
        "description": "网站描述"
      },
      "category": {
        "type": "string",
        "enum": ["education", "developer", "tools", "entertainment"],
        "description": "分类"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "标签"
      },
      "rating": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "default": 5,
        "description": "推荐指数 (1-5)"
      },
      "language": {
        "type": "string",
        "enum": ["中文", "英文"],
        "default": "中文"
      }
    }
  }
}
